{
  "name": "genesis-360",
  "version": "1.2.1-rc.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:check": "node scripts/check-migrations.mjs",
    "quality": "pnpm lock:check && pnpm public:check && pnpm work:check && pnpm security:check && pnpm lint && pnpm typecheck && pnpm test:hardening && pnpm test && pnpm build",
    "work:check": "node scripts/verify-work-package.mjs && node scripts/check-openapi.mjs && node scripts/check-design-system.mjs && node scripts/check-hardening-integrity.mjs",
    "security:check": "node scripts/check-security-contracts.mjs && node scripts/check-trust-boundaries.mjs",
    "db:test": "supabase test db",
    "contract:check": "node scripts/check-openapi.mjs",
    "design:check": "node scripts/check-design-system.mjs",
    "deps:bootstrap": "node scripts/bootstrap-dependencies.mjs",
    "lock:check": "node scripts/check-lockfile.mjs",
    "test:hardening": "node --test tests/hardening-native/core.test.cjs",
    "syntax:check": "node scripts/check-typescript-syntax.cjs",
    "public:check": "node scripts/check-public-package.mjs",
    "integrity:check": "node scripts/check-hardening-integrity.mjs",
    "production:state-check": "node scripts/check-production-scale-baseline.mjs",
    "delivery:check": "node scripts/check-delivery-config.mjs",
    "test:e2e:production": "node tests/e2e-production.mjs",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "sbom:generate:runtime": "node scripts/generate-sbom.mjs test-results/hsp4-runtime-linux-x64.sbom.spdx.json --platform=linux --arch=x64",
    "demo:prepare": "node scripts/prepare-demo-scenario.mjs",
    "worker:outbox": "node workers/outbox-worker.mjs",
    "worker:outbox:once": "node workers/outbox-worker.mjs --once",
    "typecheck:domain": "node scripts/typecheck-domain.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.108.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.21.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "24.1.0",
    "playwright-core": "1.63.0",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@eslint/plugin-kit": "0.3.4",
      "postcss": "8.5.23"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
