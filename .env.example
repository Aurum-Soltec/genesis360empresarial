NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

FEATURE_ECOSYSTEM=false
FEATURE_QUALIFICATION_NETWORK=false
FEATURE_AGENTIC=false
FEATURE_TAX=true
FEATURE_REAL_CONTACT=false

# Server-only. Never expose with NEXT_PUBLIC_ and never pass to an agent/sandbox.
SUPABASE_SERVICE_ROLE_KEY=

# Dedicated worker runtime; use a unique instance id per process.
WORKER_ID=
WORKER_BATCH_SIZE=25
WORKER_LEASE_SECONDS=60
WORKER_POLL_MS=1000

FEATURE_DATA_UPLOAD=false

# Controlled presentation workspace. This does not enable binary upload or Agentic.
FEATURE_DEMO_WORKSPACE=false
# Comma-separated tenant UUIDs explicitly authorized to use fictional fixtures.
DEMO_TENANT_IDS=
